# Copy to .env and fill in. Never commit the real file.

# Postgres password for the n8n database user.
POSTGRES_PASSWORD=change-me

# MUST be identical for the n8n main process and the worker: the worker has its
# own empty volume and cannot read main's config file, so it takes the key from
# here. If the worker generates its own, stored credentials become permanently
# undecryptable.
N8N_ENCRYPTION_KEY=change-me
